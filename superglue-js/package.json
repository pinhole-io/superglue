{
  "name": "superglue-js",
  "version": "1.0.0",
  "description": "Node.js bindings for the superglue Rust LLM core (napi-rs)",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js"
    },
    "./facade": {
      "types": "./dist/facade.d.ts",
      "require": "./dist/facade.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md"
  ],
  "napi": {
    "binaryName": "superglue-js",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "napi build --platform --release",
    "build:native:debug": "napi build --platform",
    "build:ts": "tsc -p tsconfig.json",
    "test": "npm run build:native:debug && node test/run.mjs",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
